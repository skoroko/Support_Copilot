# Homework 2.1 provider switch
LLM_PROVIDER=openai
LLM_TIMEOUT_SEC=60
LLM_MAX_TOKENS=500
LLM_TEMPERATURES=0,0.7,1.5

# OpenAI cloud provider
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
LOG_LEVEL=INFO

# Local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OPENAI_BASE_URL=
OLLAMA_MODELS=qwen3:1.7b,gemma3:4b
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_API_KEY=ollama

# Benchmark generation settings
BENCHMARK_TEMPERATURE=0.2
BENCHMARK_MAX_TOKENS=320
BENCHMARK_TIMEOUT_SEC=180

# Cost assumptions for the selected OpenAI model, USD per 1M tokens.
# Checked against official OpenAI pricing on 2026-05-26 for gpt-5.4-mini.
OPENAI_INPUT_PRICE_PER_1M=0.75
OPENAI_CACHED_INPUT_PRICE_PER_1M=0.075
OPENAI_OUTPUT_PRICE_PER_1M=4.50

# Homework 2.3 robust fallback provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_INPUT_PRICE_PER_1M=0
OPENROUTER_OUTPUT_PRICE_PER_1M=0

# Homework 2.3 reliability settings
ROBUST_LLM_MAX_RETRIES=5
ROBUST_LLM_BASE_BACKOFF_SEC=1
ROBUST_LLM_MAX_BACKOFF_SEC=16
ROBUST_LLM_MAX_JITTER_SEC=0.25
ROBUST_LLM_CIRCUIT_FAILURES=3
ROBUST_LLM_CIRCUIT_COOLDOWN_SEC=60
ROBUST_LLM_RATE_LIMIT_PER_MINUTE=0

# Homework 3.3 async LLM settings
ASYNC_LLM_CONCURRENCY=5
ASYNC_LLM_SDK_TIMEOUT_SEC=30
ASYNC_LLM_BUSINESS_TIMEOUT_SEC=15
ASYNC_LLM_MAX_RETRIES=3

# Homework 3.4 FastAPI LLM service
APP_DEFAULT_MODEL=gpt-5.4-mini
LLM_REQUEST_TIMEOUT=30
APP_REDIS_URL=redis://redis:6379/0
APP_CACHE_TTL_SECONDS=3600
APP_CORS_ORIGINS=*
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Homework 4.1 server-side chat history
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats
CHAT_DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support_copilot
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10
CHAT_MODEL_CONTEXT_TOKENS=128000
CHAT_RESPONSE_TOKENS=500
CHAT_SAFETY_MARGIN_TOKENS=500

# Homework 4.2 Telegram bot thin client
BOT_TOKEN=123456:replace-with-telegram-bot-token
BACKEND_URL=http://127.0.0.1:8000
BOT_ADMIN_IDS=

# Homework 4.3 media pipeline and backend -> bot notifications
TRANSCRIPTION_MODEL=whisper-1
BOT_URL=http://bot:9000
BOT_API_PORT=9000
INTERNAL_TOKEN=replace-with-a-long-random-token

# Homework 4.4 moderation, admin API, feedback and broadcasts
ADMIN_TOKEN=replace-with-a-different-long-random-token
MODERATION_ENABLED=true
MODERATION_OPENAI_ENABLED=false
MODERATION_MODEL=omni-moderation-latest
MODERATION_THRESHOLDS={}
MODERATION_KEYWORDS_PATH=app/moderation/moderation_keywords.yaml
BROADCAST_POLL_SECONDS=5
BOT_HOST_PORT=19000
APP_HOST_PORT=18000

# Homework 3.7 evaluation runner
EVAL_APP_URL=http://127.0.0.1:8000
EVAL_JUDGE_MODEL=
EVAL_TIMEOUT_SECONDS=60

# Homework 2.4 cache settings
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_PROMPT_VERSION=support-copilot-prompt-v1
LLM_CACHE_SERVICE_FACTS_VERSION=service-facts-v1
REDIS_URL=redis://redis:6379/0

# Homework 2.5 CLI settings
SUPPORT_CLI_TEMPERATURE=0.2
SUPPORT_CLI_MAX_TOKENS=500
SUPPORT_CLI_HISTORY_MESSAGES=10
SUPPORT_COPILOT_LOG_PATH=support_copilot/results/session_log.txt
SUPPORT_CLI_LOG_PATH=homework_2_5/results/session_log.txt

# Homework 2.6A Vision API settings
VISION_PROVIDER=openai
VISION_MODEL=
OPENAI_VISION_MODEL=
OPENROUTER_VISION_MODEL=
OLLAMA_VISION_MODEL=gemma3:4b
VISION_TIMEOUT_SEC=60
VISION_MAX_TOKENS=1200

# Homework 3.1 Function Calling demo
TOOL_CALL_TEMPERATURE=0
TOOL_CALL_MAX_TOKENS=500
TOOL_CALL_LOG_PATH=homework_3_1/results/tool_call_demo.jsonl
SUPPORT_COPILOT_TOOL_LOG_PATH=support_copilot/results/tool_call_log.jsonl

# Support Copilot usage assumptions for monthly cost estimates.
REQUESTS_PER_DAY=300
AVG_INPUT_TOKENS=900
AVG_OUTPUT_TOKENS=350
CACHE_HIT_RATE=0.35

# Homework 5.1 embeddings and semantic search foundation
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE_PATH=./var/embeddings.sqlite3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_MIN_SECONDS=0.25
EMBEDDING_RETRY_MAX_SECONDS=4
EMBEDDING_MAX_INPUT_TOKENS=8192

# Homework 5.2 Qdrant vector storage
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-long-random-qdrant-api-key
QDRANT_COLLECTION=documents
EMBEDDING_DIM=1024
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Homework 5.3 RAG. Keep disabled until document transfer to the configured
# embedding/LLM provider is explicitly approved.
RAG_ENABLED=false
RAG_DATA_DIR=./data/rag-block-03
RAG_LLM_MODEL=gpt-5.4-mini
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1024
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=3
RAG_MIN_SCORE=0.35
RAG_COLLECTION=rag_block_03
RAG_BAREMETAL_COLLECTION=rag_block_03_baremetal
RAG_REBUILD_ON_START=true
