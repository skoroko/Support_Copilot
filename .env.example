# Homework 2.1 provider switch
LLM_PROVIDER=openai
LLM_TIMEOUT_SEC=60
LLM_MAX_TOKENS=500
LLM_TEMPERATURES=0,0.7,1.5

# OpenAI cloud provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

# Local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OPENAI_BASE_URL=
OLLAMA_MODELS=qwen3:1.7b,gemma3:4b
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_API_KEY=ollama

# Benchmark generation settings
BENCHMARK_TEMPERATURE=0.2
BENCHMARK_MAX_TOKENS=320
BENCHMARK_TIMEOUT_SEC=180

# Cost assumptions for the selected OpenAI model, USD per 1M tokens.
# Checked against official OpenAI pricing on 2026-05-26 for gpt-5.4-mini.
OPENAI_INPUT_PRICE_PER_1M=0.75
OPENAI_CACHED_INPUT_PRICE_PER_1M=0.075
OPENAI_OUTPUT_PRICE_PER_1M=4.50

# Homework 2.3 robust fallback provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_INPUT_PRICE_PER_1M=0
OPENROUTER_OUTPUT_PRICE_PER_1M=0

# Homework 2.3 reliability settings
ROBUST_LLM_MAX_RETRIES=5
ROBUST_LLM_BASE_BACKOFF_SEC=1
ROBUST_LLM_MAX_BACKOFF_SEC=16
ROBUST_LLM_MAX_JITTER_SEC=0.25
ROBUST_LLM_CIRCUIT_FAILURES=3
ROBUST_LLM_CIRCUIT_COOLDOWN_SEC=60
ROBUST_LLM_RATE_LIMIT_PER_MINUTE=0

# Homework 2.4 cache settings
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_PROMPT_VERSION=support-copilot-prompt-v1
LLM_CACHE_SERVICE_FACTS_VERSION=service-facts-v1
REDIS_URL=redis://localhost:6379/0

# Homework 2.5 CLI settings
SUPPORT_CLI_TEMPERATURE=0.2
SUPPORT_CLI_MAX_TOKENS=500
SUPPORT_CLI_HISTORY_MESSAGES=10
SUPPORT_COPILOT_LOG_PATH=support_copilot/results/session_log.txt
SUPPORT_CLI_LOG_PATH=homework_2_5/results/session_log.txt

# Homework 2.6A Vision API settings
VISION_PROVIDER=openai
VISION_MODEL=
OPENAI_VISION_MODEL=
OPENROUTER_VISION_MODEL=
OLLAMA_VISION_MODEL=gemma3:4b
VISION_TIMEOUT_SEC=60
VISION_MAX_TOKENS=1200

# Homework 3.1 Function Calling demo
TOOL_CALL_TEMPERATURE=0
TOOL_CALL_MAX_TOKENS=500
TOOL_CALL_LOG_PATH=homework_3_1/results/tool_call_demo.jsonl
SUPPORT_COPILOT_TOOL_LOG_PATH=support_copilot/results/tool_call_log.jsonl

# Support Copilot usage assumptions for monthly cost estimates.
REQUESTS_PER_DAY=300
AVG_INPUT_TOKENS=900
AVG_OUTPUT_TOKENS=350
CACHE_HIT_RATE=0.35
