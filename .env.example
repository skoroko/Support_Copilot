# OpenAI cloud provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_STRONG_MODEL=gpt-5.4

# Provider switch for homework 2.1.
# Values: openai, openrouter
LLM_PROVIDER=openai

# Support Copilot CLI settings
SUPPORT_COPILOT_MODEL=gpt-5.4-mini
SUPPORT_COPILOT_TEMPERATURE=0.2
SUPPORT_COPILOT_MAX_TOKENS=600
LLM_TIMEOUT_SEC=60
LLM_CACHE_TTL_SEC=3600

# Homework 2.6 Vision API settings.
# Set VISION_MODEL to a current image-capable model from official provider docs.
VISION_MODEL=gpt-5.4-mini
VISION_BASE_URL=
VISION_API_KEY=
VISION_TEMPERATURE=0.2
VISION_MAX_TOKENS=500
VISION_DETAIL=auto
VISION_TIMEOUT_SEC=120

# Optional OpenAI-compatible provider, for example OpenRouter.
# If these are set, benchmark_models.py can use them instead of OpenAI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_INPUT_PRICE_PER_1M=0
OPENROUTER_OUTPUT_PRICE_PER_1M=0

# Local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=qwen3:1.7b,gemma3:4b

# Benchmark generation settings
BENCHMARK_TEMPERATURE=0.2
BENCHMARK_MAX_TOKENS=320
BENCHMARK_TIMEOUT_SEC=180

# Cost assumptions for the selected OpenAI model, USD per 1M tokens.
# Checked against official OpenAI pricing on 2026-05-26 for gpt-5.4-mini.
OPENAI_INPUT_PRICE_PER_1M=0.75
OPENAI_CACHED_INPUT_PRICE_PER_1M=0.075
OPENAI_OUTPUT_PRICE_PER_1M=4.50

# Optional strong model pricing, USD per 1M tokens.
# Checked against official OpenAI pricing on 2026-05-26 for gpt-5.4.
OPENAI_STRONG_INPUT_PRICE_PER_1M=2.50
OPENAI_STRONG_CACHED_INPUT_PRICE_PER_1M=0.25
OPENAI_STRONG_OUTPUT_PRICE_PER_1M=15.00

# Support Copilot usage assumptions for monthly cost estimates.
REQUESTS_PER_DAY=300
AVG_INPUT_TOKENS=900
AVG_OUTPUT_TOKENS=350
CACHE_HIT_RATE=0.35
