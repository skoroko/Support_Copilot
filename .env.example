# Homework 2.1 provider switch
LLM_PROVIDER=openai
LLM_TIMEOUT_SEC=60
LLM_MAX_TOKENS=500
LLM_TEMPERATURES=0,0.7,1.5

# OpenAI cloud provider
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
# Legacy CLI model and fallback for CLI Vision; the bot uses APP_DEFAULT_MODEL below.
OPENAI_MODEL=gpt-5.4-mini
LOG_LEVEL=INFO

# Local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OPENAI_BASE_URL=
OLLAMA_MODELS=qwen3:1.7b,gemma3:4b
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_API_KEY=ollama

# Benchmark generation settings
BENCHMARK_TEMPERATURE=0.2
BENCHMARK_MAX_TOKENS=320
BENCHMARK_TIMEOUT_SEC=180

# Cost assumptions for the selected OpenAI model, USD per 1M tokens.
# Checked against official OpenAI pricing on 2026-05-26 for gpt-5.4-mini.
OPENAI_INPUT_PRICE_PER_1M=0.75
OPENAI_CACHED_INPUT_PRICE_PER_1M=0.075
OPENAI_OUTPUT_PRICE_PER_1M=4.50

# Homework 2.3 robust fallback provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_INPUT_PRICE_PER_1M=0
OPENROUTER_OUTPUT_PRICE_PER_1M=0

# Homework 2.3 reliability settings
ROBUST_LLM_MAX_RETRIES=5
ROBUST_LLM_BASE_BACKOFF_SEC=1
ROBUST_LLM_MAX_BACKOFF_SEC=16
ROBUST_LLM_MAX_JITTER_SEC=0.25
ROBUST_LLM_CIRCUIT_FAILURES=3
ROBUST_LLM_CIRCUIT_COOLDOWN_SEC=60
ROBUST_LLM_RATE_LIMIT_PER_MINUTE=0

# Homework 3.3 async LLM settings
ASYNC_LLM_CONCURRENCY=5
ASYNC_LLM_SDK_TIMEOUT_SEC=30
ASYNC_LLM_BUSINESS_TIMEOUT_SEC=15
ASYNC_LLM_MAX_RETRIES=3

# Homework 3.4 FastAPI LLM service
APP_DEFAULT_MODEL=gpt-6-luna
# Current bot configuration: Responses API, medium for ordinary and expanded answers.
# compose.luna.yaml overrides these settings when explicitly included in Compose.
AGENT_LLM_API=responses
# Supported: none/low/medium/high/xhigh/max. Empty inherits low for GPT-6, none for older models.
AGENT_REASONING_EFFORT=low
# Empty inherits AGENT_REASONING_EFFORT; explicit medium documents the deployed choice.
AGENT_EXPANDED_REASONING_EFFORT=medium
# Total output cap = CHAT_*_RESPONSE_TOKENS + reserve when reasoning is enabled.
# The provider has no separate hard cap for visible text versus reasoning.
AGENT_REASONING_TOKEN_RESERVE=8192
# Historical setting retained for compatibility; does not select a production route.
AGENT_VERIFIED_OVERVIEW_ENABLED=false
# Generic evidence preparation; historical HSS flags no longer select routes.
AGENT_PREPARED_EVIDENCE_ENABLED=true
AGENT_GENERATION_TIMEOUT=120
LLM_REQUEST_TIMEOUT=30
APP_REDIS_URL=redis://redis:6379/0
APP_CACHE_TTL_SECONDS=3600
APP_CORS_ORIGINS=*
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=support-copilot-rag
TRACING_ENABLED=false
# JSON array is required by the environment settings loader.
APP_ALLOWED_MODELS='["gpt-6-luna","gpt-5.4-mini"]'
APP_RATE_LIMIT_PER_MINUTE=60
APP_MAX_CONCURRENCY_PER_PRINCIPAL=4
INGESTION_QUEUE_CAPACITY=4

# Homework 5.6 RAGAS judge (separate from production RAG generation)
RAG_EVAL_JUDGE_MODEL=gpt-4o-mini
RAG_EVAL_EMBEDDING_MODEL=text-embedding-3-small
RAG_EVAL_CONCURRENCY=3
RAG_EVAL_CONTEXT_PRECISION_CONCURRENCY=2
RAG_EVAL_METRIC_TIMEOUT_SECONDS=180
RAG_EVAL_ANSWER_RELEVANCY_STRICTNESS=1

# Optional generic search experiment; keep disabled until corpus acceptance passes.
RAG_PLANNER_ENABLED=false
RAG_PLANNER_MODEL=
RAG_PLANNER_EFFORT=none
RAG_PLANNER_TIMEOUT=5

# Homework 4.1 server-side chat history
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats
CHAT_DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support_copilot
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10
CHAT_MEDIA_MAX_BYTES=10485760
# Chat multipart accepts at most 4 files and 2 * CHAT_MEDIA_MAX_BYTES + 1 MiB total raw body.
CHAT_MODEL_CONTEXT_TOKENS=128000
CHAT_RESPONSE_TOKENS=800
# Only after explicit confirmation of a detailed answer; output ceiling, not a price.
CHAT_EXPANDED_RESPONSE_TOKENS=1500
CHAT_SAFETY_MARGIN_TOKENS=500

# Homework 6.4 persistent LangGraph agent.  Local development uses SQLite;
# docker-compose overrides this to the existing Postgres database.  Do not use
# a random thread_id per turn: keep it stable for one user/scenario.
AGENT_CHECKPOINTER=sqlite
AGENT_SQLITE_PATH=./var/agent_checkpoints.sqlite
# Optional explicit psycopg-v3 URI; otherwise POSTGRES_* below are used.
AGENT_POSTGRES_URI=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=support_copilot
POSTGRES_USER=support
POSTGRES_PASSWORD=replace-with-local-postgres-password
LANGGRAPH_STRICT_MSGPACK=true

# Homework 4.2 Telegram bot thin client
BOT_TOKEN=123456:replace-with-telegram-bot-token
BACKEND_URL=http://127.0.0.1:8000
BOT_ADMIN_IDS=
BOT_ALLOWED_USER_IDS=
BOT_ALLOWED_CHAT_IDS=

# Homework 4.3 media pipeline and backend -> bot notifications
TRANSCRIPTION_MODEL=whisper-1
BOT_URL=http://bot:9000
BOT_API_PORT=9000
INTERNAL_TOKEN=replace-with-a-long-random-token

# Homework 4.4 moderation, admin API, feedback and broadcasts
ADMIN_TOKEN=replace-with-a-different-long-random-token
MODERATION_ENABLED=true
MODERATION_OPENAI_ENABLED=false
MODERATION_MODEL=omni-moderation-latest
MODERATION_THRESHOLDS={}
MODERATION_KEYWORDS_PATH=app/moderation/moderation_keywords.yaml
BROADCAST_POLL_SECONDS=5
BOT_HOST_PORT=19000
APP_HOST_PORT=18000

# Homework 3.7 evaluation runner
EVAL_APP_URL=http://127.0.0.1:8000
EVAL_JUDGE_MODEL=
EVAL_TIMEOUT_SECONDS=60

# Homework 2.4 cache settings
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_PROMPT_VERSION=support-copilot-prompt-v1
LLM_CACHE_SERVICE_FACTS_VERSION=service-facts-v1
REDIS_URL=redis://redis:6379/0

# Homework 2.5 CLI settings
SUPPORT_CLI_TEMPERATURE=0.2
SUPPORT_CLI_MAX_TOKENS=500
SUPPORT_CLI_HISTORY_MESSAGES=10
SUPPORT_COPILOT_LOG_PATH=support_copilot/results/session_log.txt
SUPPORT_CLI_LOG_PATH=homework_2_5/results/session_log.txt

# Homework 2.6A Vision API settings
# These settings configure CLI /image, not the Telegram agent.
# OpenAI model precedence: OPENAI_VISION_MODEL > VISION_MODEL > OPENAI_MODEL.
VISION_PROVIDER=openai
VISION_MODEL=
OPENAI_VISION_MODEL=
OPENROUTER_VISION_MODEL=
OLLAMA_VISION_MODEL=gemma3:4b
VISION_TIMEOUT_SEC=60
VISION_MAX_TOKENS=1200

# Homework 3.1 Function Calling demo
TOOL_CALL_TEMPERATURE=0
TOOL_CALL_MAX_TOKENS=500
TOOL_CALL_LOG_PATH=homework_3_1/results/tool_call_demo.jsonl
SUPPORT_COPILOT_TOOL_LOG_PATH=support_copilot/results/tool_call_log.jsonl

# Support Copilot usage assumptions for monthly cost estimates.
REQUESTS_PER_DAY=300
AVG_INPUT_TOKENS=900
AVG_OUTPUT_TOKENS=350
CACHE_HIT_RATE=0.35

# Homework 5.1 embeddings and semantic search foundation
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE_PATH=./var/embeddings.sqlite3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_MIN_SECONDS=0.25
EMBEDDING_RETRY_MAX_SECONDS=4
EMBEDDING_MAX_INPUT_TOKENS=8192

# Homework 5.2 Qdrant connection (shared by the app RAG service and scripts)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-long-random-qdrant-api-key
# Experiment corpus for scripts/load_to_qdrant.py and
# scripts/vector_store_experiments.py. Not read by the app: the production
# corpus lives exclusively in RAG_COLLECTION.
QDRANT_COLLECTION=documents
EMBEDDING_DIM=1024
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Homework 5.5 RAG. Keep disabled until document transfer to the configured
# embedding/LLM provider is explicitly approved.
RAG_ENABLED=false
# Set false to attach to an already built RAG_COLLECTION without re-reading
# documents or sending embedding requests during app startup.
RAG_INGEST_ON_START=true
# Set true only after the document owner approves sending corpus fragments to
# the configured external embedding/LLM provider.
RAG_ALLOW_EXTERNAL_DATA_TRANSFER=false
RAG_DATA_DIR=./data
RAG_DOCSTORE_PATH=./var/rag_eval_chunk_1024_docstore.json
# Empty catalog path derives a .corpus.json sibling of RAG_DOCSTORE_PATH.
RAG_EVIDENCE_CATALOG_PATH=
# Optional approved visual transcription sidecar; see docs/documentation_evidence.md.
RAG_VISUAL_TRANSCRIPTIONS_PATH=
RAG_RETRIEVAL_CONCURRENCY=2
RAG_LLM_MODEL=gpt-6-luna
# RAG answers use low reasoning by default; retrieval/embeddings are unchanged
# by the answer model selection.
RAG_REASONING_EFFORT=low
# Answer-generation timeout (seconds); retrieval calls keep LLM_REQUEST_TIMEOUT.
RAG_GENERATION_TIMEOUT=120
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1024
RAG_CHUNK_STRATEGY=recursive
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=10
# Primary product: ingestion default tag for unmarked files and the scoped
# retrieval pool. Must be a product key (gts_nx, civil, fea_nx, gen, ...) —
# scope tokens like "all" belong to RAG_PRODUCT_SCOPE instead.
RAG_PRODUCT=gts_nx
# Retrieval product scope: strict = only RAG_PRODUCT chunks; fallback = try
# RAG_PRODUCT first, then retry over the whole corpus when it has no usable
# evidence (keeps explicitly labelled sibling products reachable while the
# corpus is thin); all = no product filter at all.
RAG_PRODUCT_SCOPE=fallback
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Empty means auto-select (CUDA when supported, otherwise CPU).
RAG_RERANKER_DEVICE=
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANKER_TOP_N=5
RAG_SCORE_THRESHOLD=0.45
RAG_CONDENSE_ENABLED=true
# LLM translation of the retrieval-focused question for English-manual recall
# when the caller did not supply one (evidence prefetch, plain answer calls).
# When false (or on failure) retrieval continues with the Russian query only.
RAG_TRANSLATE_LLM_ENABLED=true
# Exact full-text recall complements dense retrieval without rebuilding embeddings.
RAG_LEXICAL_RETRIEVAL_ENABLED=true
# Manual ranking weights: rank = cosine + TERM*term_coverage + PAIR*pair_coverage.
# Defaults were tuned on the eval set; 0/0 disables the lexical boost.
RAG_LEXICAL_TERM_WEIGHT=0.7
RAG_LEXICAL_PAIR_WEIGHT=0.3
RAG_COLLECTION=rag_eval_chunk_1024
RAG_BAREMETAL_COLLECTION=rag_block_03_baremetal
# Compatibility setting: Б5.5 never deletes the collection at startup.
RAG_REBUILD_ON_START=false
